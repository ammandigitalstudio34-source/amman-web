rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "QXpWsJiQE9N0e4lb12J2oFqUfyk2";
    }

    function hasVerifiedProfile(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.verified == true;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == profileId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == profileId
        && request.resource.data.verified == false;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == profileId
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.id == resource.data.id
          && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == profileId);
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "open"
        && !request.resource.data.keys().hasAny(["phone", "notes"])
        && (!request.resource.data.keys().hasAny(["requestedPhotographerUid"])
          || (request.resource.data.requestedPhotographerUid is string
            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.requestedPhotographerUid))
            && (!get(/databases/$(database)/documents/profiles/$(request.resource.data.requestedPhotographerUid)).data.keys().hasAny(["busyDates"])
              || !(request.resource.data.date in get(/databases/$(database)/documents/profiles/$(request.resource.data.requestedPhotographerUid)).data.busyDates))));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.status == "open"
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.photographerUid == request.auth.uid
          && request.resource.data.photographer
            == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name
          && (!request.resource.data.keys().hasAny(["requestedPhotographerUid"])
            || request.resource.data.requestedPhotographerUid == request.auth.uid)
          && (
            (request.resource.data.status == "confirmed"
              && hasVerifiedProfile(request.auth.uid)
              && (!get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.keys().hasAny(["busyDates"])
                || !(resource.data.date in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.busyDates))
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "photographer", "photographerUid", "confirmedAt"]))
            || (request.resource.data.status == "busy"
              && request.resource.data.keys().hasAny(["requestedPhotographerUid"])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "photographer", "photographerUid", "busyAt"]))
          ));
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.ownerUid)
        || (signedIn()
          && ((resource.data.keys().hasAny(["requestedPhotographerUid"])
              && request.auth.uid == resource.data.requestedPhotographerUid)
            || (resource.data.keys().hasAny(["photographerUid"])
              && request.auth.uid == resource.data.photographerUid)));
    }

    match /gigPrivate/{gigId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.ownerUid)
        || (signedIn()
          && get(/databases/$(database)/documents/gigs/$(gigId)).data.status == "confirmed"
          && get(/databases/$(database)/documents/gigs/$(gigId)).data.photographerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/gigs/$(gigId)).data.ownerUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.ownerUid)
        || (signedIn()
          && exists(/databases/$(database)/documents/gigs/$(gigId))
          && ((get(/databases/$(database)/documents/gigs/$(gigId)).data.keys().hasAny(["requestedPhotographerUid"])
              && request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.requestedPhotographerUid)
            || (get(/databases/$(database)/documents/gigs/$(gigId)).data.keys().hasAny(["photographerUid"])
              && request.auth.uid == get(/databases/$(database)/documents/gigs/$(gigId)).data.photographerUid)));
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.photographerUid != request.auth.uid
        && request.resource.data.participants.hasAll([
          request.resource.data.customerUid,
          request.resource.data.photographerUid
        ])
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.photographerUid));
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.customerUid == resource.data.customerUid
          && request.resource.data.photographerUid == resource.data.photographerUid
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["lastMessageText", "lastMessageAt", "lastSenderRole", "updatedAt"]));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function validMessage() {
          return request.resource.data.keys().hasOnly(["senderUid", "senderRole", "text", "t"])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.t is int;
        }

        allow read: if isAdmin()
          || (signedIn() && request.auth.uid in parentConversation().participants);
        allow create: if validMessage()
          && ((isAdmin()
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderRole == "admin")
          || (signedIn()
            && request.resource.data.senderUid == request.auth.uid
            && ((request.resource.data.senderRole == "customer"
                && request.auth.uid == parentConversation().customerUid)
              || (request.resource.data.senderRole == "photographer"
                && request.auth.uid == parentConversation().photographerUid))));
        allow update, delete: if isAdmin();
      }
    }

    match /fcmTokens/{userId} {
      allow read, write: if false;

      match /devices/{deviceId} {
        function ownsToken() {
          return signedIn() && request.auth.uid == userId;
        }

        function validTokenData() {
          return request.resource.data.keys().hasOnly(["uid", "token", "updatedAt"])
            && request.resource.data.keys().hasAll(["uid", "token", "updatedAt"])
            && request.resource.data.uid == userId
            && request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() <= 4096
            && request.resource.data.updatedAt is timestamp;
        }

        allow get: if ownsToken()
          && (!exists(/databases/$(database)/documents/fcmTokens/$(userId)/devices/$(deviceId))
            || resource.data.uid == userId);
        allow list: if ownsToken() && resource.data.uid == userId;
        allow create: if ownsToken() && validTokenData();
        allow update: if ownsToken()
          && resource.data.uid == userId
          && validTokenData();
        allow delete: if ownsToken() && resource.data.uid == userId;
      }
    }

    match /notificationEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
